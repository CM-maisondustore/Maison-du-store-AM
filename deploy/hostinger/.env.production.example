APP_NAME="Maison du Store AM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.maisondustoream.com
APP_TIMEZONE=Africa/Abidjan
APP_FORCE_HTTPS=true
SITE_INDEXING=true
# Set only proxy IPs documented by Hostinger if a proxy is enabled.
TRUSTED_PROXIES=
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Copy the exact names from hPanel, including the account prefix.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
