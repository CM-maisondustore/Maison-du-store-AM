APP_NAME="Maison du Store AM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.maisondustoream.com
APP_TIMEZONE=Africa/Abidjan
APP_FORCE_HTTPS=true
SITE_INDEXING=true
# Set only proxy IPs documented by Hostinger if a proxy is enabled.
# The live site is served through the Hostinger CDN (Server: hcdn). If the CDN is not trusted here,
# all visitors may share one rate limit (10 submissions/min). Never use "*": clients could spoof their IP.
TRUSTED_PROXIES=
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Copy the exact names from hPanel, including the account prefix.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file

# Espace interne : Hostinger Email (mot de passe de la boite, jamais dans Git)
COMMERCIAL_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@maisondustoream.com
MAIL_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Identite de facturation : completer avant emission d'une facture
BILLING_NAME="Maison du Store AM"
BILLING_ADDRESS=
BILLING_REGISTRATION=
BILLING_TAX_NOTE=
BILLING_PAYMENT_TERMS=
