APP_NAME="Maison du Store AM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Abidjan
LOG_CHANNEL=single
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
SESSION_SECURE_COOKIE=false
APP_FORCE_HTTPS=false
SITE_INDEXING=false
TRUSTED_PROXIES=

# Espace interne : Hostinger Email (mot de passe de la boite, jamais dans Git)
COMMERCIAL_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@maisondustoream.com
MAIL_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Identite de facturation : completer avant emission d'une facture
BILLING_NAME="Maison du Store AM"
BILLING_ADDRESS=
BILLING_REGISTRATION=
BILLING_TAX_NOTE=
BILLING_PAYMENT_TERMS=
