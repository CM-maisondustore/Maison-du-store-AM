APP_NAME="Maison du Store AM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Abidjan
LOG_CHANNEL=single
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
SESSION_SECURE_COOKIE=false
APP_FORCE_HTTPS=false
SITE_INDEXING=false
TRUSTED_PROXIES=

# Web Push for the staff workspace; generate a pair with `php artisan push:keys`.
# Keep the private key secret and use different keys locally and in production.
PUSH_VAPID_SUBJECT=mailto:contact@maisondustoream.com
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# Espace interne : Hostinger Email (mot de passe de la boite, jamais dans Git)
COMMERCIAL_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@maisondustoream.com
MAIL_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Numero WhatsApp professionnel (avec indicatif pays)
WHATSAPP_NUMBER=+2250712449319

# Identite de facturation : completer avant emission d'une facture
BILLING_NAME="Maison du Store AM"
BILLING_ADDRESS=
BILLING_REGISTRATION=
BILLING_TAX_NOTE=
BILLING_PAYMENT_TERMS=
